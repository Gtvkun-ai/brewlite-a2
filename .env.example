# ==============================================================================
# BrewLite - Assignment 2 Environment Configuration Template
# ==============================================================================

# Database Configuration (PostgreSQL). Set matching values before use.
DATABASE_URL=
POSTGRES_USER=brew
POSTGRES_PASSWORD=
POSTGRES_DB=brewlite
POSTGRES_PORT=5432
DEMO_ACCOUNT_PASSWORD=
E2E_ACCOUNT_PASSWORD=

# Backend API Configuration (NestJS)
PORT=3001
NODE_ENV=development
JWT_SECRET=
JWT_EXPIRATION=7d
CORS_ORIGIN="http://localhost:3000"

# Frontend Application (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:3001"
PORT=3000
NEXT_PUBLIC_USE_FIXTURES=true
