@startuml
title Mô hình dữ liệu BrewLite
!pragma layout smetana
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam linetype polyline
hide circle
hide methods

package "Bán hàng và tài khoản" {
  class User {
    id : String
    email : String {unique}
    fullName : String
    phone : String?
    address : String?
    passwordHash : String
    role : Role
  }
  class Order {
    id : String
    code : String {unique}
    userId : String
    status : OrderStatus
    subTotal, discountAmount, totalAmount : Decimal
    deliveryNote : String?
    idempotencyKey : String? {unique}
    promotionId : String?
  }
  class OrderItem {
    id, orderId, productId : String
    quantity : Int
    unitPrice, itemTotal : Decimal
    selectedSize : String?
    selectedToppings : String[]
    selectedSugar : Int
    selectedIce : String
  }
  class Payment {
    id, orderId : String
    method : PaymentMethod
    status : PaymentStatus
    amount : Decimal
    transactionRef : String?
    idempotencyKey : String? {unique}
  }
  class Promotion {
    id : String
    code : String {unique}
    type : PromotionType
    value, minOrderValue : Decimal
    maxDiscount : Decimal?
    validFrom, validTo : DateTime
    isActive : Boolean
  }
  class LoyaltyTransaction {
    id, userId : String
    orderId : String? {unique}
    pointsChange, balanceAfter : Int
  }
}
package "Danh mục và kho nguyên liệu" {
  class Product {
    id : String
    code : String {unique}
    name, category : String
    basePrice : Decimal
    isAvailable : Boolean
    stockQuantity : Int
  }
  class ProductRecipe {
    id, productCode, ingredientId : String
    size : RecipeSize
    amount : Decimal(14,2)
  }
  class Ingredient {
    id : String
    code : String {unique}
    name, unit, category : String
    currentStock : Decimal(14,2)
    baselineStock : Decimal(14,2)
    minThreshold : Decimal(14,2)
  }
  class InventoryMovement {
    id, ingredientId : String
    ingredientCodeSnapshot, ingredientNameSnapshot : String
    unitSnapshot : String
    type : InventoryMovementType
    amount, beforeStock, afterStock : Decimal(14,2)
    note : String?
    referenceKey : String? {unique}
    createdAt : DateTime
  }
}
User "1" -- "0..*" Order
User "1" -- "0..*" LoyaltyTransaction
Order "1" *-- "1..*" OrderItem
Product "1" -- "0..*" OrderItem
Order "1" -- "0..*" Payment : các lần thanh toán
Promotion "0..1" -- "0..*" Order
Order "0..1" -- "0..1" LoyaltyTransaction
Product "1" -- "0..*" ProductRecipe : Product.code
Ingredient "1" -- "0..*" ProductRecipe
Ingredient "1" -- "0..*" InventoryMovement

note bottom of ProductRecipe
  Unique (productCode, size, ingredientId).
  RecipeSize gồm REGULAR và LARGE.
end note
note bottom of InventoryMovement
  OPENING, RESTOCK, ADJUSTMENT, SALE,
  ORDER_CANCELLED, PAYMENT_FAILED.
end note
note bottom of Payment
  E_WALLET, VIETQR_MOMO,
  CREDIT_CARD, DOMESTIC_ATM, CASH.
  PENDING, SUCCESS, FAILED,
  REFUND_PENDING, REFUNDED.
end note
@enduml
