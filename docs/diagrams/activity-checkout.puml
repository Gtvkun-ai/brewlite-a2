@startuml
title Hoạt động đặt món và thanh toán
skinparam defaultFontName Arial
skinparam ActivityFontSize 13

|Next.js Web|
start
:Chọn món, size, topping, đường và đá;
if (Có phiên đăng nhập?) then (Có)
else (Chưa)
  :Giữ giỏ hàng và đăng nhập;
endif
:Gửi POST /orders với key tạo đơn;

|NestJS API|
:Kiểm tra JWT, DTO và key tạo đơn;
if (Đơn đã tồn tại cùng key và payload?) then (Có)
  :Trả đơn đã tạo;
else (Mới)
  :Mở transaction và giữ tồn thành phẩm có điều kiện;
  if (Món có định mức BOM?) then (Có)
    :Trừ nguyên liệu theo size nếu còn đủ;
    :Ghi các dòng SALE;
  endif
  if (Tồn thành phẩm và nguyên liệu hợp lệ?) then (Đủ)
    :Tính giá, tạo PENDING và OrderItem;
    :Commit;
  else (Thiếu tồn)
    :Rollback, trả OUT_OF_STOCK hoặc OUT_OF_STOCK_INGREDIENT;
    |Next.js Web|
    :Giữ giỏ và hiển thị lỗi;
    stop
  endif
endif

|Next.js Web|
repeat
  :Gửi POST /payments với orderId và key thanh toán;
  |NestJS API|
  :Khóa Order và kiểm tra chủ đơn, trạng thái, key;
  if (Replay cùng key và payload?) then (Có)
    :Trả kết quả đã lưu;
  else (Lần thử mới)
    :Gọi Mock Gateway;
    if (Đơn đang PAYMENT_FAILED?) then (Có)
      :Giữ lại tồn thành phẩm và nguyên liệu nếu đủ;
    endif
    if (Gateway trả SUCCESS?) then (Có)
      :Lưu Payment SUCCESS, chuyển PAID và commit;
    else (FAILED)
      :Lưu Payment FAILED và hoàn tồn;
      :Ghi PAYMENT_FAILED vào sổ kho, cập nhật Order và commit;
    endif
    :Trả kết quả thanh toán qua HTTP 200;
  endif
  |Next.js Web|
  if (Kết quả FAILED đã xác nhận?) then (Có)
    :Giữ orderId và sinh key mới;
  endif
repeat while (Khách chọn thử lại sau FAILED?) is (Có) not (Dừng hoặc thành công)
if (SUCCESS?) then (Có)
  :Xóa giỏ và mở /orders/{orderId};
else (Dừng)
  :Giữ dữ liệu đang có và hiển thị lỗi;
endif
stop
@enduml
