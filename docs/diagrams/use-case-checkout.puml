@startuml
title Ca sử dụng đặt món và thanh toán
!pragma layout smetana
left to right direction
skinparam defaultFontName Arial

actor "Khách hàng" as Customer
actor "Mock Gateway" as Gateway
rectangle BrewLite {
  usecase "Xác thực phiên JWT" as Auth
  usecase "Tạo đơn PENDING" as Create
  usecase "Giữ tồn thành phẩm" as SKU
  usecase "Trừ nguyên liệu và ghi SALE" as BOM
  usecase "Thanh toán mô phỏng\ncó Idempotency-Key" as Payment
  usecase "Thử lại trên cùng đơn" as Retry
  usecase "Xem chi tiết và tiến độ đơn" as Track
}
Customer --> Create
Customer --> Payment
Customer --> Track
Create ..> Auth : <<include>>
Create ..> SKU : <<include>>
BOM ..> Create : <<extend>>\nkhi món có định mức
Payment ..> Auth : <<include>>
Retry ..> Payment : <<extend>>\nkhi đã xác nhận FAILED
Payment --> Gateway
@enduml
