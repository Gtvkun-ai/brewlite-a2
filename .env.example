# ==============================================================================
# BrewLite - Assignment 2 Environment Configuration Template
# ==============================================================================

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://brew:brew@localhost:5432/brewlite?schema=public"
POSTGRES_USER=brew
POSTGRES_PASSWORD=brew
POSTGRES_DB=brewlite
POSTGRES_PORT=5432

# Backend API Configuration (NestJS)
PORT=3001
NODE_ENV=development
JWT_SECRET=super-secret-jwt-key-for-local-development-only-change-in-production
JWT_EXPIRATION=7d
CORS_ORIGIN="http://localhost:3000"

# Frontend Application (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:3001"
PORT=3000
