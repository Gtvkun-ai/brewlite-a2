{
  "info": {
    "name": "BrewLite A2 · Demo tranh tồn kho",
    "description": "Hai ca tích hợp qua NestJS API thật trên máy cục bộ. Chọn một request, nhấn Send và xem Test Results. Mỗi ca tạo món tạm, kiểm tra tồn kho rồi hủy đơn và tắt bán món thử.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Demo · Hai khách tranh 2 bánh cuối",
      "request": {
        "method": "GET",
        "url": "{{demoApiUrl}}/health",
        "description": "Nhấn Send một lần rồi mở Test Results. Demo gọi NestJS API thật trên 127.0.0.1:3101, tạo một món có tồn 2 và gửi hai đơn đồng thời bằng hai tài khoản khách. Sau đó demo đọc tồn kho, hủy đơn thử và tắt bán món. Khởi động lại API nếu cần bằng node scripts/demo.cjs api trong repo."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const api = pm.variables.get('demoApiUrl');",
              "const demoPassword = 'Password123!';",
              "",
              "async function request(method, path, { token, body, key } = {}) {",
              "  const header = { Accept: 'application/json' };",
              "  if (token) header.Authorization = 'Bearer ' + token;",
              "  if (key) header['Idempotency-Key'] = key;",
              "  const options = { url: api + path, method, header };",
              "  if (body !== undefined) {",
              "    header['Content-Type'] = 'application/json';",
              "    options.body = { mode: 'raw', raw: JSON.stringify(body) };",
              "  }",
              "  const response = await new Promise((resolve, reject) => {",
              "    pm.sendRequest(options, (error, result) => {",
              "      if (error) reject(error);",
              "      else resolve(result);",
              "    });",
              "  });",
              "  return { status: response.code, body: response.json() };",
              "}",
              "",
              "function expectStatus(response, expected, action) {",
              "  pm.expect(response.status, action + ' · ' + JSON.stringify({",
              "    errorCode: response.body.errorCode, message: response.body.message",
              "  })).to.equal(expected);",
              "}",
              "",
              "async function login(email, role) {",
              "  const response = await request('POST', '/auth/login', {",
              "    body: { email, password: demoPassword }",
              "  });",
              "  expectStatus(response, 200, 'Đăng nhập ' + email);",
              "  pm.expect(response.body.user.role).to.equal(role);",
              "  pm.expect(response.body.accessToken).to.be.a('string').that.is.not.empty;",
              "  return response.body;",
              "}",
              "",
              "async function getStock(productId) {",
              "  const response = await request('GET', '/products/' + productId);",
              "  expectStatus(response, 200, 'Đọc tồn kho');",
              "  return response.body.stockQuantity;",
              "}",
              "",
              "async function runDemo() {",
              "  pm.expect(api, 'Địa chỉ API demo cục bộ').to.match(/^http:\\/\\/127\\.0\\.0\\.1:\\d{1,5}$/);",
              "  pm.test('API local và PostgreSQL sẵn sàng', () => {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json()).to.have.nested.property('database.status', 'up');",
              "  });",
              "  if (pm.response.code !== 200 || pm.response.json().database?.status !== 'up') return;",
              "",
              "  let admin;",
              "  let productId;",
              "  const orders = [];",
              "  try {",
              "    let customerA, customerB;",
              "    [admin, customerA, customerB] = await Promise.all([",
              "      login('admin@brewlite.vn', 'ADMIN'),",
              "      login('customer@brewlite.vn', 'CUSTOMER'),",
              "      login('customer@brewlite.test', 'CUSTOMER')",
              "    ]);",
              "    pm.test('SETUP · Hai tài khoản CUSTOMER khác nhau', () => {",
              "      pm.expect(customerA.user.id).to.be.a('string').that.is.not.empty;",
              "      pm.expect(customerB.user.id).to.be.a('string').that.is.not.empty;",
              "      pm.expect(customerA.user.id).to.not.equal(customerB.user.id);",
              "    });",
              "",
              "    const runId = pm.variables.replaceIn('{{$guid}}');",
              "    const product = await request('POST', '/products', {",
              "      token: admin.accessToken,",
              "      body: {",
              "        code: 'DEMO-RACE-' + runId,",
              "        name: 'Bánh Croissant — Demo tranh tồn kho',",
              "        basePrice: 30000,",
              "        imageUrl: '/img/croissant.jpg',",
              "        category: 'Pastry',",
              "        isAvailable: true,",
              "        stockQuantity: 2",
              "      }",
              "    });",
              "    expectStatus(product, 201, 'Tạo món demo');",
              "    pm.expect(product.body.id).to.be.a('string').that.is.not.empty;",
              "    productId = product.body.id;",
              "",
              "    const before = await getStock(productId);",
              "    pm.test('BEFORE · Tồn kho đọc từ API = ' + before, () => {",
              "      pm.expect(before).to.equal(2);",
              "    });",
              "    if (before !== 2) return;",
              "",
              "    const users = [customerA, customerB];",
              "    const body = { items: [{ productId, quantity: 2, selectedSize: 'REGULAR' }] };",
              "    const results = await Promise.allSettled(users.map((user, index) =>",
              "      request('POST', '/orders', {",
              "        token: user.accessToken,",
              "        body,",
              "        key: 'demo-race-' + runId + '-' + index",
              "      })",
              "    ));",
              "    const responses = results.map((result, index) => {",
              "      if (result.status === 'rejected') return 'lỗi kết nối';",
              "      const { status, body } = result.value;",
              "      if (status === 201 && typeof body.id === 'string') {",
              "        orders.push({ id: body.id, code: body.code, token: users[index].accessToken });",
              "      }",
              "      return status + (body.errorCode ? ' ' + body.errorCode : '');",
              "    });",
              "",
              "    pm.test('RACE · Khách A: ' + responses[0] + ' | Khách B: ' + responses[1], () => {",
              "      pm.expect(responses.slice().sort()).to.deep.equal(['201', '400 OUT_OF_STOCK']);",
              "      pm.expect(orders).to.have.lengthOf(1);",
              "    });",
              "",
              "    const after = await getStock(productId);",
              "    pm.test('AFTER · Tồn kho đọc từ API = ' + after, () => {",
              "      pm.expect(after).to.equal(0);",
              "    });",
              "  } catch (error) {",
              "    pm.test('Demo chạy qua API thành công', () => { throw error; });",
              "  } finally {",
              "    if (productId) {",
              "      for (const order of orders) {",
              "        const label = 'CLEANUP · Hủy đơn ' + order.code;",
              "        try {",
              "          const cancelled = await request('PATCH', '/orders/' + order.id + '/cancel', {",
              "            token: order.token, body: {}",
              "          });",
              "          pm.test(label, () => {",
              "            expectStatus(cancelled, 200, 'Hủy đơn ' + order.code);",
              "            pm.expect(cancelled.body.status).to.equal('CANCELLED');",
              "          });",
              "        } catch (error) {",
              "          pm.test(label, () => pm.expect.fail(String(error)));",
              "        }",
              "      }",
              "      try {",
              "        const restored = await getStock(productId);",
              "        pm.test('RESTORED · Tồn kho đọc từ API = ' + restored, () => {",
              "          pm.expect(restored).to.equal(2);",
              "        });",
              "      } finally {",
              "        const hidden = await request('PATCH', '/products/' + productId, {",
              "          token: admin.accessToken,",
              "          body: { isAvailable: false }",
              "        });",
              "        pm.test('CLEANUP · Tắt bán món thử trên DB demo', () => {",
              "          expectStatus(hidden, 200, 'Tắt bán món demo');",
              "          pm.expect(hidden.body.isAvailable).to.equal(false);",
              "        });",
              "      }",
              "    }",
              "  }",
              "}",
              "",
              "runDemo().catch((error) => {",
              "  pm.test('Demo kết thúc đầy đủ', () => { throw error; });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Demo · Gửi lại thanh toán cùng key",
      "request": {
        "method": "GET",
        "url": "{{demoApiUrl}}/health",
        "description": "Kiểm tra gửi lại cùng key trả đúng giao dịch, payload khác bị từ chối 409, tồn kho giữ nguyên và được phục hồi sau khi hủy đơn."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const api = pm.variables.get('demoApiUrl');",
              "const demoPassword = 'Password123!';",
              "",
              "async function request(method, path, { status = 200, token, body, key } = {}) {",
              "  const header = { Accept: 'application/json' };",
              "  if (token) header.Authorization = 'Bearer ' + token;",
              "  if (key) header['Idempotency-Key'] = key;",
              "  const options = { method, url: api + path, header };",
              "  if (body !== undefined) {",
              "    header['Content-Type'] = 'application/json';",
              "    options.body = { mode: 'raw', raw: JSON.stringify(body) };",
              "  }",
              "  const response = await new Promise((resolve, reject) => {",
              "    pm.sendRequest(options, (error, result) => {",
              "      if (error) reject(error);",
              "      else resolve(result);",
              "    });",
              "  });",
              "  pm.expect(response.code, method + ' ' + path).to.equal(status);",
              "  return response.json();",
              "}",
              "",
              "async function login(email, role) {",
              "  const session = await request('POST', '/auth/login', { body: { email, password: demoPassword } });",
              "  pm.expect(session.user.role).to.equal(role);",
              "  pm.expect(session.accessToken).to.be.a('string').that.is.not.empty;",
              "  return session.accessToken;",
              "}",
              "",
              "async function runDemo() {",
              "  pm.expect(api, 'Địa chỉ API demo cục bộ').to.match(/^http:\\/\\/127\\.0\\.0\\.1:\\d{1,5}$/);",
              "  const healthy = pm.response.code === 200 && pm.response.json().database?.status === 'up';",
              "  pm.test('API local và PostgreSQL sẵn sàng', () => pm.expect(healthy).to.be.true);",
              "  if (!healthy) return;",
              "",
              "  const [admin, customer] = await Promise.all([",
              "    login('admin@brewlite.vn', 'ADMIN'),",
              "    login('customer@brewlite.vn', 'CUSTOMER')",
              "  ]);",
              "  const runId = pm.variables.replaceIn('{{$guid}}');",
              "  const product = await request('POST', '/products', {",
              "    status: 201,",
              "    token: admin,",
              "    body: {",
              "      code: 'DEMO-PAY-' + runId,",
              "      name: 'Bánh Croissant — Demo gửi lại thanh toán',",
              "      basePrice: 30000,",
              "      imageUrl: '/img/croissant.jpg',",
              "      category: 'Pastry',",
              "      isAvailable: true,",
              "      stockQuantity: 2",
              "    }",
              "  });",
              "  pm.expect(product.id).to.be.a('string').that.is.not.empty;",
              "  const productPath = '/products/' + product.id;",
              "  let order;",
              "  try {",
              "    const before = await request('GET', productPath);",
              "    order = await request('POST', '/orders', {",
              "      status: 201,",
              "      token: customer,",
              "      key: 'order-' + runId,",
              "      body: { items: [{ productId: product.id, quantity: 1, selectedSize: 'REGULAR' }] }",
              "    });",
              "    const reserved = await request('GET', productPath);",
              "    pm.test('BEFORE · Kho ' + before.stockQuantity + ' → ' + reserved.stockQuantity + ' khi tạo đơn', () => {",
              "      pm.expect(before.stockQuantity).to.equal(2);",
              "      pm.expect(order.status).to.equal('PENDING');",
              "      pm.expect(reserved.stockQuantity).to.equal(1);",
              "    });",
              "",
              "    const key = 'payment-' + runId;",
              "    const body = { orderId: order.id, method: 'E_WALLET', accountRef: 'DEMO-1234' };",
              "    const first = await request('POST', '/payments', { token: customer, key, body });",
              "    const afterFirst = await request('GET', productPath);",
              "    pm.test('PAY · HTTP 200, SUCCESS, tổng tiền ' + first.amount + 'đ', () => {",
              "      pm.expect(first).to.include({ status: 'SUCCESS', orderId: order.id, orderStatus: 'PAID', amount: order.totalAmount });",
              "      pm.expect(first.paymentId).to.be.a('string').that.is.not.empty;",
              "      pm.expect(first.transactionRef).to.be.a('string').that.is.not.empty;",
              "      pm.expect(afterFirst.stockQuantity).to.equal(1);",
              "    });",
              "",
              "    const replay = await request('POST', '/payments', { token: customer, key, body });",
              "    pm.test('REPLAY · HTTP 200, cùng paymentId ' + first.paymentId, () => {",
              "      pm.expect(replay).to.deep.equal(first);",
              "    });",
              "",
              "    const conflict = await request('POST', '/payments', {",
              "      status: 409,",
              "      token: customer,",
              "      key,",
              "      body: { ...body, accountRef: 'DEMO-5678' }",
              "    });",
              "    pm.test('CONFLICT · Cùng key, nội dung khác → HTTP 409', () => {",
              "      pm.expect(conflict.errorCode).to.equal('IDEMPOTENCY_KEY_PAYLOAD_MISMATCH');",
              "    });",
              "",
              "    const afterReplay = await request('GET', productPath);",
              "    pm.test('AFTER · Kho vẫn là ' + afterReplay.stockQuantity + ' sau khi gửi lại', () => {",
              "      pm.expect(afterReplay.stockQuantity).to.equal(afterFirst.stockQuantity);",
              "    });",
              "  } finally {",
              "    try {",
              "      if (order?.id) {",
              "        const cancelled = await request('PATCH', '/orders/' + order.id + '/cancel', {",
              "          token: customer, body: {}",
              "        });",
              "        pm.test('CLEANUP · Hủy đơn ' + order.code, () => pm.expect(cancelled.status).to.equal('CANCELLED'));",
              "        const restored = await request('GET', productPath);",
              "        pm.test('RESTORED · Tồn kho quay về ' + restored.stockQuantity, () => pm.expect(restored.stockQuantity).to.equal(2));",
              "      }",
              "    } finally {",
              "      const hidden = await request('PATCH', productPath, { token: admin, body: { isAvailable: false } });",
              "      pm.test('CLEANUP · Tắt bán món thử trên DB demo', () => pm.expect(hidden.isAvailable).to.equal(false));",
              "    }",
              "  }",
              "}",
              "",
              "runDemo().catch((error) => {",
              "  pm.test('Demo thanh toán chạy đầy đủ', () => pm.expect.fail(String(error)));",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "demoApiUrl",
      "value": "http://127.0.0.1:3101",
      "type": "string"
    }
  ]
}
