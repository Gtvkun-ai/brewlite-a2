@startuml
title Ca sử dụng hệ thống BrewLite
!pragma layout smetana
left to right direction
skinparam defaultFontName Arial
skinparam packageStyle rectangle

actor "Khách hàng" as Customer
actor "Nhân viên pha chế" as Barista
actor "Quản lý / Quản trị viên" as Manager
actor "Mock Gateway" as Gateway

rectangle BrewLite {
  usecase "Duyệt thực đơn, tùy biến món\nvà quản lý giỏ" as Menu
  usecase "Đăng ký, đăng nhập\nvà quản lý hồ sơ" as Profile
  usecase "Tạo đơn và thanh toán" as Checkout
  usecase "Xem lịch sử, tiến độ\nvà hủy đơn đủ điều kiện" as Track
  usecase "Xử lý đơn qua KDS" as KDS
  usecase "Đọc tồn kho và dự báo theo BOM" as Forecast
  usecase "Chạy Test D mô phỏng" as Demo
  usecase "Nhập kho và điều chỉnh tồn" as Restock
  usecase "Quản lý thực đơn và voucher" as Catalog
  usecase "Xem dashboard doanh thu" as Dashboard
  usecase "Xử lý ví/thẻ mô phỏng" as Pay
}
Customer --> Menu
Customer --> Profile
Customer --> Checkout
Customer --> Track
Barista --> KDS
Barista --> Forecast : qua API
Barista --> Demo : qua API
Manager --> KDS
Manager --> Forecast
Manager --> Demo
Manager --> Restock
Manager --> Catalog
Manager --> Dashboard
Pay ..> Checkout : <<extend>>
Pay --> Gateway
@enduml
