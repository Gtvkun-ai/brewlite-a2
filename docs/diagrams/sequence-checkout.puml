@startuml
title Tuần tự đặt món và thanh toán
skinparam defaultFontName Arial
skinparam ParticipantPadding 12

participant "Next.js Web" as Web
participant "NestJS REST API" as API
participant "OrdersService" as Orders
participant "PaymentsService" as Payments
participant "InventoryService" as Inventory
database "PostgreSQL" as DB
participant "Mock Gateway" as Mock

Web -> API: POST /orders (JWT, key tạo đơn, items)
API -> Orders: createOrder(userId, dto, key)
Orders -> DB: BEGIN, kiểm tra key và giữ tồn thành phẩm
opt Món có BOM
  Orders -> Inventory: deductRecipe(productCode, size, quantity, tx)
  Inventory -> DB: Cập nhật Ingredient có điều kiện, ghi SALE
end
alt Thiếu thành phẩm hoặc nguyên liệu
  Orders -> DB: ROLLBACK
  API --> Web: 400 OUT_OF_STOCK hoặc OUT_OF_STOCK_INGREDIENT
else Đủ hàng
  Orders -> DB: Tạo Order PENDING cùng OrderItem, COMMIT
  API --> Web: 201 { id, code, status: PENDING }
end

== Thanh toán cho đơn đã tạo ==
Web -> API: POST /payments (JWT, key thanh toán, orderId)
API -> Payments: createPayment(userId, dto, key)
Payments -> DB: BEGIN, khóa Order và đối chiếu quyền sở hữu
alt Cùng key và cùng payload
  DB --> Payments: Payment đã ghi
  API --> Web: 200 trả kết quả đã lưu
else Lần thanh toán mới hợp lệ
  Payments -> Mock: charge(amount từ Order, method, accountRef)
  Mock --> Payments: SUCCESS hoặc FAILED
  opt Đơn đang PAYMENT_FAILED
    Payments -> DB: Giữ lại tồn thành phẩm
    Payments -> Inventory: Giữ lại nguyên liệu theo BOM
    Inventory -> DB: Ghi SALE
  end
  Payments -> DB: Lưu Payment
  alt SUCCESS
    Payments -> DB: Chuyển Order sang PAID, COMMIT
    API --> Web: 200 SUCCESS và orderId
    Web -> Web: Xóa giỏ, mở /orders/{orderId}
  else FAILED
    Payments -> DB: Hoàn tồn thành phẩm
    Payments -> Inventory: Hoàn nguyên liệu có BOM
    Inventory -> DB: Ghi biến động PAYMENT_FAILED
    Payments -> DB: Chuyển Order sang PAYMENT_FAILED, COMMIT
    API --> Web: 200 FAILED
    Web -> Web: Giữ orderId, đổi key cho lần thử mới
  end
end
@enduml
