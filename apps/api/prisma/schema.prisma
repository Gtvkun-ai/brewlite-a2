// BrewLite domain schema — models the full domain from
// docs/diagrams/class-domain.puml. See ADR-004 (PostgreSQL + Prisma).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  BARISTA
  MANAGER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
  PAYMENT_FAILED
}

// enum PaymentStatus {
//   PENDING
//   SUCCESS
//   FAILED
//   REFUNDED
// }
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum PaymentMethod {
  E_WALLET
  VIETQR_MOMO
  CREDIT_CARD
  DOMESTIC_ATM
  CASH
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]
}

model Product {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String
  basePrice     Decimal
  imageUrl      String
  category      String
  isAvailable   Boolean  @default(true)
  stockQuantity Int      @default(0)
  createdAt     DateTime @default(now())

  orderItems OrderItem[]
}

model Order {
  id             String      @id @default(cuid())
  code           String      @unique
  userId         String
  status         OrderStatus @default(PENDING)
  subTotal       Decimal
  discountAmount Decimal     @default(0)
  totalAmount    Decimal
  deliveryNote   String?
  idempotencyKey String?     @unique
  promotionId    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user               User                @relation(fields: [userId], references: [id])
  promotion          Promotion?          @relation(fields: [promotionId], references: [id])
  items              OrderItem[]
  payments           Payment[]
  loyaltyTransaction LoyaltyTransaction?
}

model OrderItem {
  id               String   @id @default(cuid())
  orderId          String
  productId        String
  quantity         Int
  unitPrice        Decimal
  selectedSize     String?
  selectedToppings String[]
  itemTotal        Decimal

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id                     String        @id @default(cuid())
  orderId                String
  method                 PaymentMethod
  status                 PaymentStatus @default(PENDING)
  amount                 Decimal
  transactionRef         String?
  idempotencyKey         String?       @unique
  paymentGatewayResponse Json?
  createdAt              DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model Promotion {
  id            String        @id @default(cuid())
  code          String        @unique
  description   String
  type          PromotionType
  value         Decimal
  minOrderValue Decimal       @default(0)
  maxDiscount   Decimal?
  validFrom     DateTime
  validTo       DateTime
  isActive      Boolean       @default(true)

  orders Order[]
}

model LoyaltyTransaction {
  id           String   @id @default(cuid())
  userId       String
  orderId      String?  @unique
  pointsChange Int
  balanceAfter Int
  description  String
  createdAt    DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])
}
